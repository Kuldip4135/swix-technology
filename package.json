{
  "name": "swix-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"npm:dev:site\" \"npm:dev:css\"",
    "dev:site": "eleventy --serve",
    "dev:css": "tailwindcss -i ./src/assets/css/input.css -o ./dist/assets/css/style.css --watch",
    "build": "npm run build:site && npm run build:css",
    "build:site": "eleventy",
    "build:css": "tailwindcss -i ./src/assets/css/input.css -o ./dist/assets/css/style.css --minify"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@tailwindcss/cli": "^4.1.14",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.14"
  }
}
