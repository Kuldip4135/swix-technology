<footer class="site-footer">
  <div class="site-shell footer-grid">
    <div class="footer-intro">
      <p class="eyebrow eyebrow-inverse">Career support, carefully considered.</p>
      <p>For students, graduates, experienced professionals, and employers.</p>
    </div>
    <div>
      <p class="footer-heading">Navigate</p>
      <ul>
        {% for item in nav %}
          <li><a href="{{ item.url | siteUrl }}">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </div>
    <div>
      <p class="footer-heading">Contact</p>
      <p>{{ site.emailPlaceholder }}</p>
      <p>{{ site.phonePlaceholder }}</p>
      <p class="footer-note">Static placeholders—replace before launch.</p>
      <p><a class="footer-contact-link" href="{{ '/contact/' | siteUrl }}">Open contact page ↗</a></p>
    </div>
    <div>
      <p class="footer-heading">Market experience</p>
      <p>USA · UK · Canada</p>
      <p class="footer-note">Markets our team has worked with—not a boundary on who may enquire.</p>
    </div>
  </div>
  <div class="site-shell footer-bottom">
    <p>© <span data-current-year></span> SWIX</p>
    <p>Human judgment leads.</p>
  </div>
  <div class="footer-wordmark" aria-hidden="true">SWIX</div>
</footer>
